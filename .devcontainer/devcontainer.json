{
  "name": "Covalence",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04@sha256:d94c97dd9cacf183d0a6fd12a8e87b526e9e928307674ae9c94139139c0c6eae",
  "features": {
    "ghcr.io/devcontainers/features/nix:1": {
      "version": "2.34.8",
      "extraNixConfig": "experimental-features = nix-command flakes"
    }
  },
  "remoteUser": "vscode",
  "remoteEnv": {
    "PATH": "/home/vscode/.nix-profile/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "nix develop --no-update-lock-file --command bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "mkhl.direnv"]
    }
  }
}
